# =============================================================================
# Smart Home Hub Platform — GCP Terraform Configuration
# =============================================================================
# Copy this file to terraform.tfvars and fill in your values.

# GCP Configuration
gcp_project_id = "your-gcp-project-id"
gcp_region     = "us-central1"
environment    = "dev"

# Database (use a strong password in production!)
db_username = "smarthome_admin"
db_password = "CHANGE_ME_STRONG_PASSWORD"

# =============================================================================
# Tuya Integration
# =============================================================================
# tuya_client_id / tuya_client_secret aren't wired through yet — they'll
# land alongside Secret Manager + the SDK abstraction. Only the device
# allowlist is plumbed through for now.
tuya_device_ids = ""

# =============================================================================
# Cloud Run sizing
# =============================================================================
min_instances = 2
max_instances = 4
log_level     = "INFO"
