# =============================================================================
# Smart Home Hub Platform — GCP Terraform Configuration
# =============================================================================
# Copy this file to terraform.tfvars and fill in your values.

# GCP Configuration
gcp_project_id = "your-gcp-project-id"
gcp_region     = "us-central1"
environment    = "dev"

# Database (use a strong password in production!)
db_username = "smarthome_admin"
db_password = "CHANGE_ME_STRONG_PASSWORD"

# =============================================================================
# Tuya Integration
# =============================================================================
# Get these from: https://iot.tuya.com → Cloud → Development → Your Project
# Leave blank if not integrating with Tuya — services will still deploy,
# tuya-bridge will just fail when called.
tuya_client_id     = ""
tuya_client_secret = ""
tuya_region        = "us" # us, eu, cn, in
tuya_device_ids    = ""

# =============================================================================
# Cloud Run sizing
# =============================================================================
min_instances = 2
max_instances = 4
log_level     = "INFO"
