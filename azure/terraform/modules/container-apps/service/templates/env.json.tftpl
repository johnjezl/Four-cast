[
  {"name": "CLOUD_PROVIDER",                              "value": "azure"},
  {"name": "AZURE_KEY_VAULT_URL",                         "value": ${jsonencode(key_vault_url)}},
  {"name": "AZURE_SERVICEBUS_FULLY_QUALIFIED_NAMESPACE",  "value": ${jsonencode(servicebus_namespace_fqdn)}},
  {"name": "SERVICEBUS_QUEUE",                            "value": ${jsonencode(servicebus_queue_name)}},
  {"name": "SERVICEBUS_DLQ_QUEUE",                        "value": ${jsonencode(servicebus_dlq_name)}},
  {"name": "SECRET_NAME",                                 "value": ${jsonencode(tuya_secret_name)}},
  {"name": "ENVIRONMENT",                                 "value": ${jsonencode(environment)}},
  {"name": "LOG_LEVEL",                                   "value": ${jsonencode(log_level)}},
  {"name": "DATABASE_URL",                                "value": ${jsonencode(database_url)}},
  {"name": "TUYA_DEVICE_IDS",                             "value": ${jsonencode(tuya_device_ids)}},
  {"name": "SERVICE_NAME",                                "value": ${jsonencode(service_name)}},
  {"name": "PORT",                                        "value": ${jsonencode(port)}},
  {"name": "AZURE_CLIENT_ID",                             "value": ${jsonencode(azure_client_id)}}
%{ if device_service_url != "" },
  {"name": "DEVICE_SERVICE_URL",                          "value": ${jsonencode(device_service_url)}}
%{ endif ~}
%{ if tuya_bridge_url != "" },
  {"name": "TUYA_BRIDGE_URL",                             "value": ${jsonencode(tuya_bridge_url)}}
%{ endif ~}
]
